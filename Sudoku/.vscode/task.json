{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar proyecto",
      "type": "shell",
      "command": "javac",
      "args": [
        "-cp", ".;lib/jgap.jar",
        "-d", "bin",
        "src/*.java"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Ejecutar",
      "type": "shell",
      "command": "java",
      "args": [
        "-cp", "bin;lib/jgap.jar",
        "PrincipalMon"
      ],
      "group": "test"
    }
  ]
}